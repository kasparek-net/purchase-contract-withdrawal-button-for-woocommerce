msgid "Withdraw from purchase contract"
msgstr "Odstoupit od kupní smlouvy"

#: includes/class-pcwb-frontend.php:119
msgid ""
"This order is no longer eligible for withdrawal (the cooling-off period has "
"expired, or a withdrawal has already been submitted)."
msgstr ""
"Pro tuto objednávku již nelze podat odstoupení (vypršela lhůta nebo již bylo "
"odstoupení podáno)."

